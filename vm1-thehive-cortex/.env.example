# VM1 — TheHive + Cortex environment variables
# Copy to .env and fill in real values

ELASTIC_PASSWORD=ElasticPass321!

# TheHive secret key (generate with: openssl rand -hex 32)
THEHIVE_SECRET=changeme_generate_with_openssl_rand_hex_32

# Cortex API key for TheHive integration (set after first Cortex login)
CORTEX_API_KEY=your_cortex_ensam_org_api_key
