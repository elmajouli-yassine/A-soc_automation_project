# =============================================================
#  A-SOC PROJECT — Environment Variables Template
#  Copy this file to .env and fill in your values.
#  NEVER commit the real .env file.
# =============================================================

# ── Tailscale IPs (update after joining your tailnet) ────────
VM1_IP=100.125.10.71        # TheHive + Cortex
VM2_IP=100.89.154.73        # Wazuh
VM3_IP=100.117.88.123       # Shuffle

# ── TheHive ──────────────────────────────────────────────────
THEHIVE_API_KEY=your_thehive_api_key_here
THEHIVE_ADMIN_EMAIL=admin@thehive.local
THEHIVE_ADMIN_PASSWORD=ChangeMe123!

# ── Cortex ───────────────────────────────────────────────────
CORTEX_API_KEY=your_cortex_api_key_here
CORTEX_ADMIN_PASSWORD=ChangeMe123!

# ── External APIs ────────────────────────────────────────────
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here

# ── Notifications ────────────────────────────────────────────
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# ── Shuffle ──────────────────────────────────────────────────
SHUFFLE_DEFAULT_USERNAME=admin
SHUFFLE_DEFAULT_PASSWORD=ChangeMe123!
SHUFFLE_ENCRYPTION_MODIFIER=SomeRandomString123
OPENSEARCH_INITIAL_ADMIN_PASSWORD=StrongOpenSearch321!
