<!--
  =============================================================
   Wazuh Custom Decoder — ML-SOC Pipeline
   File: /var/ossec/etc/decoders/ml-soc-decoder.xml
   Permissions: chmod 640 | chown root:wazuh
  =============================================================
-->

<decoder name="ml-soc-root">
  <prematch>{"timestamp":</prematch>
</decoder>

<decoder name="ml-soc-json">
  <parent>ml-soc-root</parent>
  <plugin_decoder>JSON_Decoder</plugin_decoder>
  <json_null_field>discard</json_null_field>
</decoder>

<!--
  Fields extracted automatically by JSON_Decoder:
    data.ml_label       - Attack type (DDoS, PortScan, Bot, ...)
    data.src_ip         - Source IP address
    data.dst_ip         - Destination IP address
    data.src_port       - Source port
    data.dst_port       - Destination port
    data.protocol       - Protocol number (6=TCP, 17=UDP)
    data.confidence     - ML model confidence score (0.0–1.0)
    data.flow_duration  - Flow duration in microseconds
    data.source         - Always "ml_pipeline"
-->
