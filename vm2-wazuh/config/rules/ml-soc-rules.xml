<!--
  ============================================================
  ML-SOC | Règles Wazuh — pipeline de prédiction ML
  Chemin  : /var/ossec/etc/rules/ml-soc-rules.xml
  ============================================================
  Champs référencés = clés exactes du JSON de la pipeline :
    ml_label      → valeur du label prédit par le modèle
    src_ip        → IP source du flux réseau
    dst_ip        → IP destination
    dst_port      → port destination
    confidence    → score de confiance du modèle (ex: 0.9464)

  Labels couverts :
    Normal | PortScan | Brute Force | DDoS | Bot | Web Attack

  Haute Confiance (HC) = confidence ≥ 0.90
    Regex : ^0\.9[0-9] matche 0.90 → 0.99
            ^1\.0      matche 1.0

  IDs réservés :
    100099        → règle parente (pivot, level 0)
    100100–100101 → Normal
    100200–100201 → PortScan
    100300–100301 → Brute Force
    100400–100401 → DDoS
    100500–100501 → Bot
    100600–100601 → Web Attack
  ============================================================
-->

<group name="ml-soc,ids,network,">

  <!-- ════════════════════════════════════════════════════
       RÈGLE PARENTE — pivot central
       Level 0 : aucune alerte générée.
       Toutes les autres règles héritent via if_sid.
       Condition : log décodé par ml-soc-json + ml_label présent.
  ════════════════════════════════════════════════════ -->
  <rule id="100099" level="0">
    <decoded_as>json</decoded_as>
    <field name="ml_label">\.+</field>
    <description>ML-SOC | Prédiction ML reçue</description>
    <group>ml_soc,</group>
  </rule>


  <!-- ════════════════════════════════════════════════════
       NORMAL
       Level 3 — informatif, trafic légitime confirmé.
  ════════════════════════════════════════════════════ -->

  <rule id="100100" level="3">
    <if_sid>100099</if_sid>
    <field name="ml_label">^Normal$</field>
    <description>ML-SOC | Trafic normal depuis $(src_ip)</description>
    <group>normal_traffic,</group>
  </rule>

  <rule id="100101" level="3">
    <if_sid>100100</if_sid>
    <field name="confidence">^0\.9[0-9]|^1\.0</field>
    <description>ML-SOC | Trafic normal (haute confiance) depuis $(src_ip)</description>
    <group>normal_traffic,high_confidence,</group>
  </rule>


  <!-- ════════════════════════════════════════════════════
       PORT SCAN
       Level 8 — reconnaissance active.
       MITRE T1046 : Network Service Discovery
  ════════════════════════════════════════════════════ -->

  <rule id="100200" level="8">
    <if_sid>100099</if_sid>
    <field name="ml_label">^PortScan$</field>
    <description>ML-SOC | Port scan détecté depuis $(src_ip)</description>
    <group>recon,port_scan,</group>
    <mitre>
      <id>T1046</id>
    </mitre>
  </rule>

  <rule id="100201" level="10">
    <if_sid>100200</if_sid>
    <field name="confidence">^0\.9[0-9]|^1\.0</field>
    <description>ML-SOC | Port scan haute confiance depuis $(src_ip) [conf=$(confidence)]</description>
    <group>recon,port_scan,high_confidence,</group>
    <mitre>
      <id>T1046</id>
    </mitre>
  </rule>


  <!-- ════════════════════════════════════════════════════
       BRUTE FORCE
       Level 12 — attaque active sur authentification.
       MITRE T1110 : Brute Force
  ════════════════════════════════════════════════════ -->

  <rule id="100300" level="12">
    <if_sid>100099</if_sid>
    <field name="ml_label">^Brute Force$</field>
    <description>ML-SOC | Brute force depuis $(src_ip) vers $(dst_ip):$(dst_port)</description>
    <group>attack,brute_force,</group>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <rule id="100301" level="14">
    <if_sid>100300</if_sid>
    <field name="confidence">^0\.9[0-9]|^1\.0</field>
    <description>ML-SOC | Brute force haute confiance depuis $(src_ip) vers port $(dst_port) [conf=$(confidence)]</description>
    <group>attack,brute_force,high_confidence,</group>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>


  <!-- ════════════════════════════════════════════════════
       DDoS
       Level 14 — déni de service distribué critique.
       MITRE T1498 : Network Denial of Service
  ════════════════════════════════════════════════════ -->

  <rule id="100400" level="14">
    <if_sid>100099</if_sid>
    <field name="ml_label">^DDoS$</field>
    <description>ML-SOC | Attaque DDoS depuis $(src_ip) vers $(dst_ip)</description>
    <group>attack,ddos,</group>
    <mitre>
      <id>T1498</id>
    </mitre>
  </rule>

  <rule id="100401" level="15">
    <if_sid>100400</if_sid>
    <field name="confidence">^0\.9[0-9]|^1\.0</field>
    <description>ML-SOC | CRITIQUE — DDoS haute confiance depuis $(src_ip) vers $(dst_ip) [conf=$(confidence)]</description>
    <group>attack,ddos,high_confidence,</group>
    <mitre>
      <id>T1498</id>
    </mitre>
  </rule>


  <!-- ════════════════════════════════════════════════════
       BOT / BOTNET
       Level 10 — activité C2 / botnet détectée.
       MITRE T1071 : Application Layer Protocol (C2)
  ════════════════════════════════════════════════════ -->

  <rule id="100500" level="10">
    <if_sid>100099</if_sid>
    <field name="ml_label">^Bot$</field>
    <description>ML-SOC | Activité botnet depuis $(src_ip) vers $(dst_ip)</description>
    <group>malware,bot,</group>
    <mitre>
      <id>T1071</id>
    </mitre>
  </rule>

  <rule id="100501" level="13">
    <if_sid>100500</if_sid>
    <field name="confidence">^0\.9[0-9]|^1\.0</field>
    <description>ML-SOC | Botnet haute confiance depuis $(src_ip) [conf=$(confidence)]</description>
    <group>malware,bot,high_confidence,</group>
    <mitre>
      <id>T1071</id>
    </mitre>
  </rule>


  <!-- ════════════════════════════════════════════════════
       WEB ATTACK
       Level 12 — exploitation d'application web.
       MITRE T1190 : Exploit Public-Facing Application
  ════════════════════════════════════════════════════ -->

  <rule id="100600" level="12">
    <if_sid>100099</if_sid>
    <field name="ml_label">^Web Attack$</field>
    <description>ML-SOC | Attaque web depuis $(src_ip) vers $(dst_ip):$(dst_port)</description>
    <group>attack,web_attack,</group>
    <mitre>
      <id>T1190</id>
    </mitre>
  </rule>

  <rule id="100601" level="14">
    <if_sid>100600</if_sid>
    <field name="confidence">^0\.9[0-9]|^1\.0</field>
    <description>ML-SOC | Attaque web haute confiance depuis $(src_ip) vers port $(dst_port) [conf=$(confidence)]</description>
    <group>attack,web_attack,high_confidence,</group>
    <mitre>
      <id>T1190</id>
    </mitre>
  </rule>

</group>
